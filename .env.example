# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real credentials.

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------

# Signs session cookies and CSRF tokens. Generate a fresh one per deployment:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-generated-key

# Leave True for local development. MUST be False in production - when False the
# app enforces HTTPS redirects and sends a one-year HSTS header.
DEBUG=True

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Any dj-database-url connection string. PostgreSQL in production; SQLite works
# for local development:
#   sqlite:///db.sqlite3
DATABASE_URL=postgresql://user:password@host:5432/database

# ---------------------------------------------------------------------------
# The Blue Alliance
# ---------------------------------------------------------------------------

# Read API key for match schedules, event rankings and team avatars.
# Create one at https://www.thebluealliance.com/account
X_TBA_AUTH_KEY=

# ---------------------------------------------------------------------------
# Google OAuth (login)
# ---------------------------------------------------------------------------

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID. Add your callback URL to the client's authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Cloudinary (robot photo and team logo uploads)
# ---------------------------------------------------------------------------

CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Comma-separated trusted proxy IPs/CIDRs. Set the proxy addresses for every
# hop you control; forwarded client IPs are trusted only when REMOTE_ADDR is
# trusted. Leave empty unless the app is behind a configured reverse proxy.
TRUSTED_PROXIES=

# Comma-separated emails granted access on a fresh database, applied by
# migration 0003. Leave empty and add the first user via the Django admin.
SEED_AUTHORIZED_EMAILS=
